<Window x:Class="SecureVault.App.Views.ItemEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item editor" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="New item" Style="{StaticResource HeaderText}" FontSize="20" Margin="0,0,0,16"/>

            <TextBlock Text="Title" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>

            <ComboBox x:Name="TypeCombo" Style="{StaticResource ComboStyle}" SelectionChanged="TypeCombo_SelectionChanged" Margin="0,0,0,12">
                <ComboBoxItem Content="Password / login"/>
                <ComboBoxItem Content="Secure note"/>
                <ComboBoxItem Content="SSH key"/>
                <ComboBoxItem Content="API token"/>
                <ComboBoxItem Content="Encrypted file"/>
                <ComboBoxItem Content="Passkey"/>
            </ComboBox>

            <!-- Login -->
            <StackPanel x:Name="LoginPanel">
                <TextBlock Text="Username" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}" Tag="Password"/>
                    <Button Grid.Column="1" Content="Generate" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GeneratePassword_Click"/>
                </Grid>
                <TextBlock Text="Website / URL" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                <TextBlock Text="TOTP secret (base32, optional)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="OtpBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                <TextBlock Text="Notes" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginNotesBox" Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- Note -->
            <StackPanel x:Name="NotePanel" Visibility="Collapsed">
                <TextBlock Text="Note content" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="NoteBox" Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="160" AcceptsReturn="True"/>
            </StackPanel>

            <!-- SSH -->
            <StackPanel x:Name="SshPanel" Visibility="Collapsed">
                <TextBlock Text="Key type" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="SshTypeBox" Style="{StaticResource InputBox}" Text="ed25519" Margin="0,0,0,8"/>
                <TextBlock Text="Private key (PEM/OpenSSH)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="SshPrivateBox" Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="100" AcceptsReturn="True" Margin="0,0,0,8"/>
                <TextBlock Text="Public key (optional)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="SshPublicBox" Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="0,0,0,8"/>
                <TextBlock Text="Passphrase (optional)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="SshPassphraseBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- API -->
            <StackPanel x:Name="ApiPanel" Visibility="Collapsed">
                <TextBlock Text="Service" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="ApiNameBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                <TextBlock Text="Token" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="ApiTokenBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                <TextBlock Text="URL (optional)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="ApiUrlBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- File -->
            <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilePathBox" Style="{StaticResource InputBox}" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Choose file…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ChooseFile_Click"/>
                </Grid>
            </StackPanel>

            <!-- Passkey -->
            <StackPanel x:Name="PasskeyPanel" Visibility="Collapsed">
                <TextBlock Text="Relying party (e.g. webauthn.example.com)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="PasskeyRpBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                <TextBlock Text="User handle (email or username)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                <TextBox x:Name="PasskeyUserBox" Style="{StaticResource InputBox}"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
