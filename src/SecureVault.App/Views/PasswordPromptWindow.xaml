<Window x:Class="SecureVault.App.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureVault" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Enter password" Style="{StaticResource HeaderText}" FontSize="18" Margin="0,0,0,6"/>
            <TextBlock x:Name="MessageText" Text="" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordBoxStyle}" Margin="0,0,0,16" KeyDown="PasswordInput_KeyDown"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="OK" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
