<Window x:Class="SecureVault.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureVault" Width="460" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <StackPanel Margin="36,28" VerticalAlignment="Center">
            <TextBlock Text="SecureVault" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
            <TextBlock Text="Zero-knowledge encrypted vault" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,28"/>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="Unlock your vault" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <StackPanel x:Name="NewVaultPanel" Visibility="Collapsed">
                        <TextBlock Text="This appears to be your first run." Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                        <TextBlock Text="Vault name" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="VaultNameBox" Style="{StaticResource InputBox}" Text="My Vault" Margin="0,0,0,12"/>

                        <TextBlock Text="Master password (min 8 chars)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordBoxStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="Confirm master password" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordBoxStyle}" Margin="0,0,0,8"/>

                        <CheckBox x:Name="HardwareBox" Content="Protect unlock with TPM / Windows Hello (hardware key)" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" FontSize="13"/>
                    </StackPanel>

                    <StackPanel x:Name="ExistingVaultPanel">
                        <TextBlock Text="Master password" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}" Margin="0,0,0,6"
                                     KeyDown="PasswordBox_KeyDown"/>
                        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="HardwareUnlockButton" Content="Unlock with Windows Hello" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0" Visibility="Collapsed" Click="HardwareUnlockButton_Click"/>
                            <Button Content="Unlock" Style="{StaticResource PrimaryButton}" Click="UnlockButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="CreateButton" Content="Create vault" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                            Visibility="Collapsed" Click="CreateButton_Click"/>
                    <TextBlock x:Name="ToggleText" Style="{StaticResource SubText}" TextDecorations="Underline"
                               HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand" MouseDown="ToggleText_MouseDown"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="12">
                <Run Text="AES-256-GCM · XChaCha20-Poly1305 · Argon2id · TPM-backed keys · offline-first"/></TextBlock>
        </StackPanel>
    </Grid>
</Window>
