<Window x:Class="SecureVault.App.Views.PasskeyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New passkey" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Create a Windows Hello passkey" Style="{StaticResource HeaderText}" FontSize="18" Margin="0,0,0,14"/>
            <TextBlock Text="Relying party ID (e.g. webauthn.example.com)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
            <TextBox x:Name="RpBox" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
            <TextBlock Text="User handle (email / username)" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Style="{StaticResource InputBox}" Margin="0,0,0,18"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Create" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
