# EditorConfig - SecureVault
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
tab_width = 4

# ==================== C# style conventions ====================

# Naming
dotnet_naming_rule.private_members_with_underscore.symbols = private_symbols
dotnet_naming_rule.private_members_with_underscore.style = leading_underscore
dotnet_naming_rule.private_members_with_underscore.severity = suggestion
dotnet_naming_symbols.private_symbols.applicable_kinds = field,property,event,method
dotnet_naming_symbols.private_symbols.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_symbols.required_modifiers = *
dotnet_naming_style.leading_underscore.required_prefix = _
dotnet_naming_style.leading_underscore.required_suffix =
dotnet_naming_style.leading_underscore.word_separator =
dotnet_naming_style.leading_underscore.capitalization = camel_case

# Public members PascalCase
dotnet_naming_rule.public_members_must_be_pascal.symbols = public_symbols
dotnet_naming_rule.public_members_must_be_pascal.style = pascal_style
dotnet_naming_rule.public_members_must_be_pascal.severity = suggestion
dotnet_naming_symbols.public_symbols.applicable_kinds = class,struct,interface,enum,delegate,method,property,event,namespace,type_parameter
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public
dotnet_naming_style.pascal_style.capitalization = pascal_case

# Locals and parameters camelCase
dotnet_naming_rule.locals_must_be_camel.symbols = local_symbols
dotnet_naming_rule.locals_must_be_camel.style = camel_style
dotnet_naming_rule.locals_must_be_camel.severity = suggestion
dotnet_naming_symbols.local_symbols.applicable_kinds = parameter,local
dotnet_naming_style.camel_style.capitalization = camel_case

# ==================== C# formatting ====================

dotnet_sort_system_directives_first = true
dotnet_style_require_compiler_service = true

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_operators = false:none
csharp_style_expression_bodied_accessors = true:suggestion

csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

csharp_indent_braces = true
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

csharp_space_around_binary_operators = before_and_after
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true

# ==================== C# usings ====================

dotnet_remove_unnecessary_suppression_exclusions = none

[*.{xaml,axaml}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
tab_width = 2

# xUnit test methods conventionally use underscore-separated names.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

